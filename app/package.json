{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port ${PORT:-5173} --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port ${E2E_PORT:-4173} --strictPort",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "pnpm build && ../scripts/e2e-slot.sh playwright test",
    "e2e:only": "../scripts/e2e-slot.sh playwright test",
    "e2e:prod": "E2E_BASE_URL=${SITE_URL:-https://guitar.dwellsee.com} playwright test --grep @smoke"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "tonal": "6.5.1",
    "tone": "15.1.22",
    "ts-fsrs": "5.4.2",
    "workbox-window": "^7.4.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-build": "^7.4.1"
  }
}
